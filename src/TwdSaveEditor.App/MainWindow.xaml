<Window x:Class="TwdSaveEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TwdSaveEditor.App.Views"
        xmlns:vm="clr-namespace:TwdSaveEditor.App.ViewModels"
        Title="TWD Save Editor"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LoadSavesCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveChangesCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Load Saves" Command="{Binding LoadSavesCommand}"
                          InputGestureText="Ctrl+L"/>
                <MenuItem Header="_Browse Folder..." Command="{Binding BrowseFolderCommand}"/>
                <Separator/>
                <MenuItem Header="_Save Changes" Command="{Binding SaveChangesCommand}"
                          InputGestureText="Ctrl+S"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Load Saves" Command="{Binding LoadSavesCommand}" Padding="8,2"/>
                <Button Content="Browse..." Command="{Binding BrowseFolderCommand}" Padding="8,2"/>
                <Separator/>
                <Button Content="Save Changes" Command="{Binding SaveChangesCommand}" Padding="8,2"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SaveDirectory}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Save file browser -->
            <views:SaveBrowserView Grid.Column="0" DataContext="{Binding}"/>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"/>

            <!-- Right: Tabbed editor panels -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}" Margin="4">
                <TabItem Header="Decisions">
                    <views:DecisionEditorView DataContext="{Binding}"/>
                </TabItem>
                <TabItem Header="Resume Point">
                    <views:ResumePointView DataContext="{Binding}"/>
                </TabItem>
                <TabItem Header="Raw Properties">
                    <views:PropertyEditorView DataContext="{Binding}"/>
                </TabItem>
            </TabControl>

            <!-- No files overlay -->
            <Border Grid.ColumnSpan="3"
                    Background="#F8F8F8"
                    Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="TWD Save Editor"
                               FontSize="22" FontWeight="SemiBold" Foreground="#333"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="The Walking Dead: The Telltale Definitive Series"
                               FontSize="12" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Load your save files to edit game decisions and set your resume point."
                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Load Saves" Command="{Binding LoadSavesCommand}"
                                Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="Browse..." Command="{Binding BrowseFolderCommand}"
                                Padding="16,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
