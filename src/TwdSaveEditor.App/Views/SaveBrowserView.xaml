<UserControl x:Class="TwdSaveEditor.App.Views.SaveBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TwdSaveEditor.App.ViewModels">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Save Files" FontWeight="Bold" FontSize="14"
                   Margin="8,8,8,4"/>
        <ListBox ItemsSource="{Binding SaveSlots}"
                 SelectedItem="{Binding SelectedSlot}"
                 Margin="4"
                 BorderThickness="1"
                 BorderBrush="#CCCCCC">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SaveSlotViewModel}">
                    <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
