<UserControl x:Class="TwdSaveEditor.App.Views.PropertyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TwdSaveEditor.App.ViewModels">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBlock Text="Properties" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="12,0,0,0"
                     Padding="4,2"
                     VerticalAlignment="Center"
                     Tag="Search properties..."/>
        </DockPanel>

        <DataGrid ItemsSource="{Binding SelectedSlot.Properties}"
                  SelectedItem="{Binding SelectedProperty}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="4"
                  BorderThickness="1"
                  BorderBrush="#CCCCCC"
                  RowDetailsVisibilityMode="Collapsed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}"
                                    Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}"
                                    Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Value" Binding="{Binding EditableValue, Mode=TwoWay}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding ValueDisplay}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Children}" Margin="24,4,4,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PropertyViewModel}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </DockPanel>
</UserControl>
