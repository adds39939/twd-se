<UserControl x:Class="TwdSaveEditor.App.Views.DecisionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TwdSaveEditor.App.ViewModels">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Game Decisions" FontWeight="Bold" FontSize="14"
                   Margin="8,8,8,4"/>
        <TextBlock DockPanel.Dock="Top" Text="Select a save file, then change choices by season and episode."
                   Foreground="Gray" FontSize="11" Margin="8,0,8,8"/>

        <!-- S4 GUID choice stats editor -->
        <Expander DockPanel.Dock="Top" Header="Season 4 Choice GUIDs (choicestats.pro)"
                  FontWeight="SemiBold" FontSize="13" Margin="4,0,4,8"
                  Visibility="{Binding HasChoiceStats, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="12,4,0,4">
                <TextBlock Text="Each GUID represents a choice made during Season 4. Tab-separated, pipe (|) for alternatives."
                           FontWeight="Normal" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ChoiceStatsText, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Normal" FontSize="11" FontFamily="Consolas"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="200"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Expander>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
            <ItemsControl ItemsSource="{Binding Seasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SeasonViewModel}">
                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4">
                            <Expander.Header>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                            </Expander.Header>
                            <StackPanel>
                                <!-- Message when season has no editable choices -->
                                <TextBlock Margin="12,4,0,4" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChoiceDefinitions}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    Choices for this season are stored in game state files and cannot be edited through the bundle. Use the Properties tab to view raw metadata.
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Episodes}" Margin="12,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EpisodeViewModel}">
                                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Choices}" Margin="16,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
                                                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                                                    Padding="0,6,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Choice description -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                                               Text="{Binding Description}"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center"/>

                                                                    <!-- Category badge -->
                                                                    <Border Grid.Row="0" Grid.Column="1"
                                                                            CornerRadius="3"
                                                                            Padding="6,2" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#E8E8E8"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Category}" Value="Life/Death">
                                                                                        <Setter Property="Background" Value="#FFE0E0"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Category}" Value="Relationship">
                                                                                        <Setter Property="Background" Value="#E0E8FF"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding Category}"
                                                                                   FontSize="10" Foreground="#666"/>
                                                                    </Border>

                                                                    <!-- Choice selector -->
                                                                    <ComboBox Grid.Row="1" Grid.Column="0"
                                                                              Grid.ColumnSpan="2"
                                                                              Margin="0,4,0,0"
                                                                              ItemsSource="{Binding Options}"
                                                                              SelectedIndex="{Binding SelectedIndex}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
