<UserControl x:Class="TwdSaveEditor.App.Views.ResumePointView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TwdSaveEditor.App.ViewModels">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Resume Point" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="Set which season, episode, and chapter the game resumes from."
                   Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>

        <Grid DockPanel.Dock="Top"
              DataContext="{Binding ResumePoint}"
              Visibility="{Binding DataContext.ResumePoint, RelativeSource={RelativeSource AncestorType=UserControl},
                           Converter={StaticResource NullToCollapsed}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Season -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Season:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding Seasons}"
                      SelectedIndex="{Binding SelectedSeasonIndex}"
                      DisplayMemberPath="DisplayName"/>

            <!-- Episode -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Episode:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding Episodes}"
                      SelectedValue="{Binding SelectedEpisode}"
                      SelectedValuePath="Number"
                      DisplayMemberPath="DisplayName"/>

            <!-- Chapter -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Chapter:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1"
                      ItemsSource="{Binding Chapters}"
                      SelectedItem="{Binding SelectedChapter}"/>

            <!-- Game Complete -->
            <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Mark episode as complete"
                      IsChecked="{Binding IsGameComplete}"/>
        </Grid>

        <!-- Placeholder when no save is loaded -->
        <TextBlock Text="Select a save file to edit the resume point."
                   Foreground="Gray" Margin="0,20,0,0"
                   HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResumePoint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DockPanel>
</UserControl>
