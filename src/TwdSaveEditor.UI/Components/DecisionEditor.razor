<div class="decision-editor">
    @if (Slot == null || Accessor == null)
    {
        <p class="text-muted">No choice data available for this save.</p>
    }
    else
    {
        var seasonKey = Slot.DetectedSeasonKey;
        var currentSeason = CurrentSeason;

        <div class="cascade-toggle">
            <label>
                <input type="checkbox" checked="@Editor.CascadeChoices"
                       @onchange="e => Editor.CascadeChoices = (bool)(e.Value ?? false)" />
                Cascade changes to later seasons
            </label>
        </div>

        @if (currentSeason is IChoiceImporter importer)
        {
            var importSources = GetImportSources(importer);
            if (importSources.Count > 0)
            {
                <div class="import-section">
                    <p class="text-muted">Import @GetSeasonNames(importSources) choices into this @currentSeason.Name save:</p>
                    <div class="import-controls">
                        <select @bind="_selectedImportSave">
                            @foreach (var s in importSources)
                            {
                                <option value="@s.FileName">@s.FileName</option>
                            }
                        </select>
                        <button class="btn-sm" @onclick="() => ImportChoices(importer)">Import</button>
                    </div>
                </div>
            }
        }

        @if (currentSeason is IChoicePresetProvider { Presets.Count: > 0 } presetProvider)
        {
            <details class="presets-section" data-testid="presets">
                <summary>
                    <span>Quick presets</span>
                    <span class="badge">@presetProvider.Presets.Count(preset => _showEndingPresets || !preset.RevealsEnding)</span>
                </summary>
                <div class="preset-buttons">
                    @foreach (var preset in presetProvider.Presets.Where(preset => _showEndingPresets || !preset.RevealsEnding))
                    {
                        <button class="btn-sm" @onclick="() => ApplyPreset(preset)">@preset.Name</button>
                    }
                </div>
                @if (presetProvider.Presets.Any(preset => preset.RevealsEnding))
                {
                    <label class="spoiler-toggle">
                        <input type="checkbox" checked="@_showEndingPresets" data-testid="presets-endings"
                               @onchange="e => _showEndingPresets = (bool)(e.Value ?? false)" />
                        Show presets that reveal an ending
                    </label>
                }
            </details>
        }

        @if (_cachedTree != null)
        {
            var expanded = ExpandedGroup();

            @foreach (var (season, episodes) in _cachedTree)
            {
                var totalChoices = episodes.Sum(g => g.Count());

                <details open="@(season.SeasonKey == (expanded?.SeasonKey ?? seasonKey))" data-testid="season-@season.SeasonKey">
                    <summary>
                        <span>@season.Name</span>
                        <span class="badge">@totalChoices choices</span>
                    </summary>
                    <div>
                        @foreach (var epGroup in episodes)
                        {
                            var ep = season.Episodes.FirstOrDefault(e => e.Number == epGroup.Key);
                            var epTitle = ep != null ? $"Episode {epGroup.Key}: {ep.Title}" : epGroup.Key == 0 ? "Carried over from the previous season" : $"Episode {epGroup.Key}";

                            <details open="@(expanded == (season.SeasonKey, epGroup.Key))">
                                <summary>
                                    <span>@epTitle</span>
                                    <span class="badge">@epGroup.Count()</span>
                                </summary>
                                <div class="choices-list">
                                    @foreach (var choice in epGroup)
                                    {
                                        var currentIdx = GetChoiceState(choice.ChoiceKey);
                                        <div class="choice-row">
                                            <div class="choice-info">
                                                <span class="choice-desc">@choice.Description</span>
                                                <span class="badge @GetCategoryBadgeClass(choice.Category)">@choice.Category</span>
                                            </div>
                                            <select @bind:get="currentIdx" @bind:set="index => OnChoiceChanged(choice, index)">
                                                <option value="-1">-- Not set --</option>
                                                @for (int i = 0; i < choice.Options.Length; i++)
                                                {
                                                    var opt = choice.Options[i];
                                                    <option value="@i">@opt.Label</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </details>
            }
        }
    }
</div>
