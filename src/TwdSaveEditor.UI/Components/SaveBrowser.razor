<div class="save-browser">
    <div class="browser-header">
        @if (_isSupported || !_supportChecked)
        {
            <button class="btn-accent w-full" data-testid="open-directory" @onclick="OpenDirectory" disabled="@IsBusy">
                @if (IsBusy)
                {
                    <span>Loading...</span>
                }
                else
                {
                    <FolderIcon Size="14" />
                    <span>Open Save Directory</span>
                }
            </button>
        }
        else
        {
            <div class="upload-area">
                <p class="text-muted">Your browser can't open folders. Upload save files instead:</p>
                <InputFile OnChange="OnFilesUploaded" multiple accept=".bundle,.estore,.epage" />
            </div>
        }

        @if (Editor.DirectoryName == null && Editor.RememberedDirectoryName != null)
        {
            <button class="w-full" data-testid="reopen-directory" @onclick="ReopenDirectory" disabled="@IsBusy">
                Reopen @Editor.RememberedDirectoryName
            </button>
        }

        @if (Editor.DirectoryName != null || UploadsFiles)
        {
            <div class="browser-actions">
                @if (Editor.DirectoryName != null)
                {
                    <button class="reload-btn" data-testid="reload-directory" @onclick="ReloadDirectory" disabled="@IsBusy"
                            title="Read the save folder again, for example after playing">
                        Reload
                    </button>
                }
                <button class="new-save-btn" data-testid="new-save-btn" @onclick="ShowNewSaveDialog">
                    + New Save
                </button>
            </div>
        }
    </div>

    @if (Editor.DirectoryName != null)
    {
        <div class="dir-info">
            <span class="dir-name" title="@Editor.DirectoryName">@Editor.DirectoryName</span>
            <span class="dir-count">@Editor.Saves.Count file(s)</span>
        </div>
    }

    <div class="save-list" data-testid="save-list">
        @foreach (var save in Editor.Saves)
        {
            var isSelected = save == Editor.SelectedSave;
            var summary = Summary(save);
            <div class="save-item @(isSelected ? "selected" : "")" @onclick="() => SelectSave(save)">
                <div class="save-heading">
                    <span class="save-title" data-testid="save-title">@summary.Title</span>
                    @if (Editor.IsModified(save))
                    {
                        <span class="badge badge-warning" data-testid="save-unsaved">Unsaved</span>
                    }
                    @if (summary.Damaged)
                    {
                        <span class="badge badge-danger" data-testid="save-damaged" title="Part of this save can't be read">Damaged</span>
                    }
                </div>
                @if (summary.Position.Length > 0)
                {
                    <div class="save-position" data-testid="save-position">@summary.Position</div>
                }
                <div class="save-meta">
                    <span class="save-name">@save.FileName</span>
                    @if (summary.SavedAt != null)
                    {
                        <span class="save-saved">saved @summary.SavedAt</span>
                    }
                </div>
            </div>
        }
    </div>
</div>
