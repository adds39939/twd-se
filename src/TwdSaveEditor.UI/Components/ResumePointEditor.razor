<div class="resume-editor">
    @if (Slot == null)
    {
        <p class="text-muted">No save selected.</p>
        return;
    }

    <div class="resume-form">
        <div class="form-group">
            <label>Season</label>
            <div class="field-value">
                @if (_season != null)
                {
                    <span>@_season.Name</span>
                }
                else
                {
                    <span class="text-muted">Unknown (@Slot.DetectedSeasonKey)</span>
                }
            </div>
        </div>

        @if (Slot.Metadata != null && _season is IResumePointHandler resume)
        {
            <EpisodeResumeEditor Slot="Slot" Handler="resume" />
        }
        else
        {
            <p class="text-muted" data-testid="resume-unavailable">The resume point of this save cannot be read.</p>
        }
    </div>
</div>
