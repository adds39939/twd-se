<div class="resume-form">
    <div class="form-group">
        <label>Resumes at</label>
        <div class="field-value" data-testid="resume-state">
            <span>@EpisodeLabel(_state.Episode)</span>
            @if (_state.CheckpointDamaged)
            {
                <span class="checkpoint-damaged" data-testid="checkpoint-damaged"> &mdash; checkpoint damaged</span>
            }
            else if (_state.SeasonFinished)
            {
                <span class="text-muted" data-testid="season-finished"> &mdash; finished</span>
            }
            else if (_state.StartsFromBeginning)
            {
                <span class="text-muted"> &mdash; from the beginning</span>
            }
            else
            {
                <span class="text-muted"> &mdash; checkpoint @_state.Checkpoint</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_state.SavedAt))
    {
        <div class="form-group">
            <label>Saved</label>
            <div class="field-value">
                <span>@_state.SavedAt</span>
            </div>
        </div>
    }

    <div class="form-group">
        <label>Restart from</label>
        <select value="@_episode" @onchange="OnEpisodeChanged" data-testid="restart-episode">
            @foreach (var episode in Handler.ResumeEpisodes)
            {
                <option value="@episode.Number">@EpisodeLabel(episode.Number)</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Chapter</label>
        <select value="@_chapter" @onchange="OnChapterChanged" data-testid="restart-chapter">
            @if (_chapters.Count == 0)
            {
                <option value="">Start of the episode</option>
            }
            @foreach (var group in _chapters.GroupBy(chapter => chapter.Group))
            {
                @if (group.Key.Length == 0)
                {
                    @foreach (var chapter in group)
                    {
                        <option value="@chapter.Id">@ChapterLabel(chapter)</option>
                    }
                }
                else
                {
                    <optgroup label="@group.Key">
                        @foreach (var chapter in group)
                        {
                            <option value="@chapter.Id">@ChapterLabel(chapter)</option>
                        }
                    </optgroup>
                }
            }
        </select>
    </div>

    <div class="resume-info">
        @if (_state.CheckpointDamaged)
        {
            <p class="checkpoint-damaged">
                The checkpoint file of this save cannot be read, so the game cannot load it. Restart the episode to
                repair the save.
            </p>
        }
        <p class="text-muted">
            Choosing an episode or chapter replaces the in-progress checkpoint as soon as it is picked, and the save
            is written when you press Save Changes. Decisions of earlier episodes that are not set yet are filled in.
        </p>
        @foreach (var note in Handler.ResumeNotes)
        {
            <p class="text-muted">@note</p>
        }
    </div>
</div>
