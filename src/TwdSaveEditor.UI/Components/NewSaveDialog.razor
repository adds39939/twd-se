<dialog @ref="_dialogElement" id="newSaveDialog" data-testid="new-save-dialog">
    <h2>Create New Save</h2>

    <div class="dialog-form">
        <div class="form-group">
            <label>Season</label>
            <select value="@_seasonKey" @onchange="OnSeasonChanged">
                @foreach (var season in Registry.All)
                {
                    <option value="@season.SeasonKey">@season.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Episode</label>
            <select value="@_episode" @onchange="OnEpisodeChanged">
                @if (_selectedSeason != null)
                {
                    @foreach (var ep in _selectedSeason.Episodes)
                    {
                        <option value="@ep.Number">Episode @ep.Number: @ep.Title</option>
                    }
                }
            </select>
        </div>

        <div class="form-group">
            <label>File Name</label>
            <input type="text" @bind="_fileName" @bind:event="oninput" placeholder="e.g. wd1_saveslot1.bundle" />
        </div>

        @if (ExistingSave is { } existing)
        {
            <p class="replace-warning" data-testid="new-save-replaces">
                @existing.FileName already exists and will be replaced; its files are backed up first.
                @if (Editor.IsModified(existing))
                {
                    <span>Its unsaved changes will be lost.</span>
                }
            </p>
        }

        <div class="dialog-actions">
            <button @onclick="Close">Cancel</button>
            <button class="btn-accent" @onclick="Create" disabled="@(string.IsNullOrWhiteSpace(_fileName) || _creating)">
                @(_creating ? "Creating..." : ExistingSave != null ? "Replace" : "Create")
            </button>
        </div>
    </div>
</dialog>
