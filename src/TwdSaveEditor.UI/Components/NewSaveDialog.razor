<dialog @ref="_dialogElement" id="newSaveDialog" data-testid="new-save-dialog">
    <h2>Create New Save</h2>

    <div class="dialog-form">
        <div class="form-group">
            <label>Season</label>
            <select value="@_seasonKey" @onchange="OnSeasonChanged">
                @foreach (var season in Registry.All)
                {
                    <option value="@season.SeasonKey">@season.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Episode</label>
            <select value="@_episode" @onchange="OnEpisodeChanged">
                @if (_selectedSeason != null)
                {
                    @foreach (var ep in _selectedSeason.Episodes)
                    {
                        <option value="@ep.Number">Episode @ep.Number: @ep.Title</option>
                    }
                }
            </select>
        </div>

        <div class="form-group">
            <label>File Name</label>
            <span class="file-name" data-testid="new-save-file-name">@_fileName</span>
        </div>

        @if (OutsideGameSlots)
        {
            <div class="slot-warning">
                <WarningAlert data-testid="new-save-slot-warning">
                    @_selectedSeason!.Name only has @_selectedSeason.SaveSlotCount save slots and all of them are in use.
                    The game won't load this new save unless it replaces an existing one.
                </WarningAlert>
            </div>
        }

        <div class="dialog-actions">
            <button @onclick="Close">Cancel</button>
            <button class="btn-accent" @onclick="Create" disabled="@(_fileName.Length == 0 || _creating)">
                @(_creating ? "Creating..." : "Create")
            </button>
        </div>
    </div>
</dialog>
