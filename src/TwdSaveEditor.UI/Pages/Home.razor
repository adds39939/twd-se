@page "/"

<PageTitle>TWD Save Editor</PageTitle>

<div class="home-layout @LayoutClass">
    <aside class="sidebar">
        <SaveBrowser OnNewSaveRequested="ShowNewSaveDialog" OnSaveSelected="ShowEditor" />
    </aside>
    <main class="main-content">
        @if (Editor.SelectedSave != null)
        {
            <div class="save-bar">
                <button class="btn-sm back-btn" data-testid="back-to-saves" @onclick="ShowSaves">&lsaquo; Saves</button>
                <span class="save-bar-name" data-testid="save-bar-name">@Editor.SelectedSave.FileName</span>
            </div>
            <div class="editor-header">
                <div class="tab-bar">
                    <button class="@TabClass("decisions")" data-testid="tab-decisions" @onclick='() => ActiveTab = "decisions"'>Decisions</button>
                    <button class="@TabClass("resume")" data-testid="tab-resume" @onclick='() => ActiveTab = "resume"'>Resume Point</button>
                    <button class="@TabClass("inventory")" data-testid="tab-inventory" @onclick='() => ActiveTab = "inventory"'>Inventory</button>
                    <button class="@TabClass("properties")" data-testid="tab-properties" @onclick='() => ActiveTab = "properties"'>Properties</button>
                </div>
                <div class="content-toolbar">
                    <h2 class="content-title">@ActiveTabTitle</h2>
                    <div class="toolbar-actions">
                        @if (Editor.IsModified(Editor.SelectedSave))
                        {
                            <button class="discard-btn" data-testid="discard-btn" @onclick="DiscardChanges" disabled="@_saving">Discard Changes</button>
                        }
                        <button class="btn-accent save-btn" @onclick="SaveChanges" disabled="@_saving">
                            @(_saving ? "Saving..." : SaveLabel + (Editor.IsModified(Editor.SelectedSave) ? " *" : string.Empty))
                        </button>
                    </div>
                </div>
            </div>

            <div class="tab-content">
                <div class="tab-panel" hidden="@(ActiveTab != "decisions")">
                    <DecisionEditor Slot="Editor.SelectedSave" Accessor="GetAccessor()" />
                </div>
                <div class="tab-panel" hidden="@(ActiveTab != "resume")">
                    <ResumePointEditor Slot="Editor.SelectedSave" />
                </div>
                <div class="tab-panel" hidden="@(ActiveTab != "inventory")">
                    <InventoryEditor Slot="Editor.SelectedSave" />
                </div>
                <div class="tab-panel" hidden="@(ActiveTab != "properties")">
                    <PropertyEditor Slot="Editor.SelectedSave" />
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <img class="empty-logo" src="_content/TwdSaveEditor.UI/images/twd-logo.png" alt="The Walking Dead" />
                <p>Open your save directory, then pick a save to edit or create a new one.</p>
                <p class="text-muted">Supports all seasons of TWD: The Telltale Definitive Series.</p>
                <div class="disclaimer-alert">
                    <InfoIcon Size="20" class="disclaimer-icon" />
                    <p>Saves are backed up before every edit, but take care: the author isn't liable for lost or damaged saves.</p>
                </div>
            </div>
        }
    </main>
</div>

<NewSaveDialog @ref="_newSaveDialog" OnCreated="ShowEditor" />
