@inherits LayoutComponentBase

<NavigationLock ConfirmExternalNavigation="Editor.HasUnsavedChanges" />
<CloudflareAnalytics />

<div class="app-layout" data-testid="@(RendererInfo.IsInteractive ? "app-ready" : null)">
    <header class="app-header">
        <div class="header-title">
            <img class="header-icon" src="_content/TwdSaveEditor.UI/images/icon-128.png" alt="" data-testid="app-icon" />
            <span>TWD: Telltale Definitive Series - Save Editor</span>
        </div>
        <div class="header-status">@Editor.StatusMessage</div>
    </header>
    <div class="app-body">
        @Body
        <ToastContainer />
    </div>
    <footer class="app-footer">
        <span class="footer-version" data-testid="app-version">@AppInfo.Version</span>
        <div class="footer-links">
            <a href="https://github.com/adds39939/twd-se" target="_blank" rel="noopener">
                <GitHubIcon /> Source
            </a>
            <span class="footer-sep">·</span>
            <a href="https://github.com/adds39939/twd-se/issues/new" target="_blank" rel="noopener">
                <IssueIcon /> Report Issue
            </a>
            <span class="footer-sep">·</span>
            <a href="https://ko-fi.com/adds39939" target="_blank" rel="noopener">
                <KoFiIcon /> Support Me
            </a>
        </div>
    </footer>
</div>
