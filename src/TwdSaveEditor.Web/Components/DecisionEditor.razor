<div class="decision-editor">
    @if (Slot == null || Accessor == null)
    {
        <p class="text-muted">No choice data available for this save.</p>
    }
    else
    {
        var seasonKey = Slot.DetectedSeasonKey;

        <div class="cascade-toggle">
            <label>
                <input type="checkbox" checked="@Editor.CascadeChoices"
                       @onchange="e => Editor.CascadeChoices = (bool)(e.Value ?? false)" />
                Cascade changes to later seasons
            </label>
        </div>

        @if (seasonKey == "s2")
        {
            var s1Saves = Editor.Saves.Where(s => s.DetectedSeasonKey == "s1" && s.Choices != null).ToList();
            if (s1Saves.Count > 0)
            {
                <div class="import-section">
                    <p class="text-muted">Import Season 1 choices into this Season 2 save:</p>
                    <div class="import-controls">
                        <select @bind="_selectedImportSave">
                            @foreach (var s in s1Saves)
                            {
                                <option value="@s.FileName">@s.FileName</option>
                            }
                        </select>
                        <button class="btn-sm" @onclick="ImportS1Choices">Import</button>
                    </div>
                </div>
            }
        }

        @if (seasonKey == "s4" && Slot.ChoiceStats != null)
        {
            <div class="presets-section">
                <p class="text-muted">Quick presets:</p>
                <div class="preset-buttons">
                    <button class="btn-sm" @onclick='() => ApplyPreset("louis")'>Save Louis Path</button>
                    <button class="btn-sm" @onclick='() => ApplyPreset("violet")'>Save Violet Path</button>
                    <button class="btn-sm" @onclick='() => ApplyPreset("trust_aj")'>Trust AJ Path</button>
                </div>
            </div>
        }

        @if (_cachedTree != null)
        {
            @foreach (var (season, episodes) in _cachedTree)
            {
                var totalChoices = episodes.Sum(g => g.Count());

                <details open="@(season.Key == seasonKey)" data-testid="season-@season.Key">
                    <summary>
                        <span>@season.Name</span>
                        <span class="badge">@totalChoices choices</span>
                    </summary>
                    <div>
                        @foreach (var epGroup in episodes)
                        {
                            var ep = season.Episodes.FirstOrDefault(e => e.Number == epGroup.Key);
                            var epTitle = ep != null ? $"Episode {epGroup.Key}: {ep.Title}" : $"Episode {epGroup.Key}";

                            <details open="@ShouldExpandEpisode(season.Key, epGroup.Key, seasonKey)">
                                <summary>
                                    <span>@epTitle</span>
                                    <span class="badge">@epGroup.Count()</span>
                                </summary>
                                <div class="choices-list">
                                    @foreach (var choice in epGroup)
                                    {
                                        var currentIdx = GetChoiceState(choice.ChoiceKey);
                                        <div class="choice-row">
                                            <div class="choice-info">
                                                <span class="choice-desc">@choice.Description</span>
                                                <span class="badge @GetCategoryBadgeClass(choice.Category)">@choice.Category</span>
                                            </div>
                                            <select value="@currentIdx"
                                                    @onchange="e => OnChoiceChanged(choice, e)">
                                                <option value="-1">-- Not set --</option>
                                                @for (int i = 0; i < choice.Options.Length; i++)
                                                {
                                                    var opt = choice.Options[i];
                                                    <option value="@i">@opt.Label</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </details>
            }
        }
    }
</div>
