<div class="resume-editor">
    @if (Slot == null)
    {
        <p class="text-muted">No save selected.</p>
        return;
    }

    @{
        var detectedSeason = Slot.DetectedSeasonKey;
        var seasonInfo = detectedSeason != null ? SeasonInfo.FindSeason(detectedSeason) : null;
    }

    <div class="resume-form">
        <div class="form-group">
            <label>Season</label>
            <div class="field-value">
                @if (seasonInfo != null)
                {
                    <span>@seasonInfo.Name</span>
                }
                else
                {
                    <span class="text-muted">Unknown (@detectedSeason)</span>
                }
            </div>
        </div>

        <div class="form-group">
            <label>Episode</label>
            <select value="@_episode" @onchange="OnEpisodeChanged">
                @if (seasonInfo != null)
                {
                    @foreach (var ep in seasonInfo.Episodes)
                    {
                        <option value="@ep.Number">Episode @ep.Number: @ep.Title</option>
                    }
                }
            </select>
        </div>

        <div class="form-group">
            <label>Chapter</label>
            <select value="@_chapter" @onchange="OnChapterChanged">
                @for (int i = 1; i <= _maxChapters; i++)
                {
                    <option value="@i">Chapter @i</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Game Complete</label>
            <input type="checkbox" checked="@_gameComplete" @onchange="OnGameCompleteChanged" />
        </div>

        <div class="form-group">
            <label>Playtime (min)</label>
            <input type="number" min="0" value="@_playtime" @onchange="OnPlaytimeChanged" />
        </div>

        <div class="form-group">
            <label>Autosave File</label>
            <input type="text" value="@_autosaveFile" @onchange="OnAutosaveFileChanged"
                   placeholder="Autosave filename reference" />
        </div>

        <div class="resume-info">
            <p class="text-muted">
                These values control where the game resumes when you load this save.
                Changes are written to the metadata properties.
            </p>
        </div>
    </div>
</div>
