<div class="resume-editor">
    @if (Slot == null)
    {
        <p class="text-muted">No save selected.</p>
        return;
    }

    @{
        var isAutosave = IsAutosave;
        var detectedSeason = Slot.DetectedSeasonKey;
        var seasonInfo = detectedSeason != null ? SeasonInfo.FindSeason(detectedSeason) : null;
    }

    <div class="resume-form">
        <div class="form-group">
            <label>Season</label>
            <div class="field-value">
                @if (seasonInfo != null)
                {
                    <span>@seasonInfo.Name</span>
                }
                else
                {
                    <span class="text-muted">Unknown (@detectedSeason)</span>
                }
            </div>
        </div>

        <div class="form-group">
            <label>Type</label>
            <div class="field-value">
                <span>@(isAutosave ? "Autosave / Checkpoint" : "Slot Save")</span>
            </div>
        </div>

        @if (isAutosave)
        {
            <div class="form-group">
                <label>Episode</label>
                <select value="@_episodeId" @onchange="OnEpisodeIdChanged">
                    @if (seasonInfo != null)
                    {
                        @foreach (var ep in seasonInfo.Episodes)
                        {
                            var epId = _seasonHandler?.GetEpisodeId(ep.Number) ?? "";
                            <option value="@epId">Episode @ep.Number: @ep.Title</option>
                        }
                    }
                    @if (!string.IsNullOrEmpty(_episodeId) && !_knownEpisodeIds.Contains(_episodeId))
                    {
                        <option value="@_episodeId">@_episodeId (custom)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Scene</label>
                <select value="@_sceneName" @onchange="OnSceneNameChanged">
                    @foreach (var scene in _availableScenes)
                    {
                        <option value="@scene">@FormatSceneName(scene)</option>
                    }
                    @if (!string.IsNullOrEmpty(_sceneName) && !_availableScenes.Contains(_sceneName))
                    {
                        <option value="@_sceneName">@FormatSceneName(_sceneName) (current)</option>
                    }
                </select>
            </div>

            @if (EpisodeChanged)
            {
                <div class="resume-info">
                    <p class="text-muted" style="color: var(--color-warning, #f0ad4e) !important;">
                        Changing the episode will clear save state — the game will start the
                        selected episode from scratch with your current choices.
                    </p>
                </div>
            }
        }
        else
        {
            <div class="resume-info">
                <p class="text-muted">
                    Slot bundles don't control resume position — the game reads that from the
                    autosave bundle. Select the corresponding autosave to edit the resume point.
                </p>
            </div>

            <div class="form-group">
                <label>Playtime</label>
                <input type="number" min="0" value="@_playtime" @onchange="OnPlaytimeChanged" />
            </div>

            <div class="form-group">
                <label>Autosave File</label>
                <input type="text" value="@_autosaveFile" @onchange="OnAutosaveFileChanged"
                       placeholder="Autosave filename reference" />
            </div>
        }
    </div>
</div>
